{
  "name": "ai-training-demo-webapp",
  "version": "1.0.0",
  "description": "Synthetic e-commerce demo app for AI-assisted quality training exercises.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --watchman=false",
    "test:stable": "jest --watchman=false --testPathIgnorePatterns=checkoutFlow.test.js --testPathIgnorePatterns=/tests/flaky/ --testPathIgnorePatterns=/tests/ui/",
    "test:flaky": "jest tests/flaky --watchman=false --randomize --testPathIgnorePatterns=/node_modules/",
    "test:repeat": "node scripts/run-repeat.js",
    "edw:build": "node scripts/edw.js build",
    "edw:sql": "node scripts/edw.js sql",
    "edw:test": "node scripts/edw.js test",
    "test:ui": "jest tests/ui --watchman=false --testPathIgnorePatterns=/node_modules/",
    "test:api": "newman run"
  },
  "keywords": [
    "training",
    "quality",
    "demo",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "newman": "^6.2.3",
    "selenium-webdriver": "^4.51.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/flaky/",
      "/tests/ui/"
    ]
  }
}
